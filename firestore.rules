rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /players/{playerId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
    }
    
    match /archived_players/{archivedId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
    }

    match /squad_settings/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // A client may create its own profile doc (e.g. the first-load bootstrap
      // that sets sensible defaults), but once it exists, subscriptionTier,
      // aiGensCount, and isActive can only be changed by a Cloud Function using
      // the Admin SDK (which bypasses these rules entirely) - never by a direct
      // client update. This stops a client from granting itself a paid tier.
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['subscriptionTier', 'aiGensCount', 'isActive']);
    }

    match /training_sessions/{sessionId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
    }
  }
}
